# OpenAI API (サーバー側 Netlify Functions のみで使用)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs API (サーバー側 Netlify Functions のみで使用)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=tmmztcupA9Eu81ix80hq
# 日本語音声自然さ最優先の推奨モデル (eleven_multilingual_v2 / eleven_flash_v2_5)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# デモ公開・セキュリティ設定
# 商用利用許諾前の外部公開時は "false" に設定して音声生成を無効化（内部検証時は "true"）
ENABLE_ELEVENLABS_TTS=true
# 関係者限定デモのアクセスパスコード（設定時は入力が必要）
DEMO_ACCESS_PASSCODE=
# 管理画面の管理者パスワード（未設定時は管理APIをブロック）
ADMIN_PASSWORD=change_this_admin_password

# API利用上限・安全制御
MAX_TTS_CHARS_PER_TURN=240
MAX_TTS_CALLS_PER_SESSION=25
MAX_SESSION_DURATION_MINUTES=20
